# ==============================================================================
# HOPO SHOP — FRONTEND ENVIRONMENT VARIABLES (VERCEL / LOCAL)
# ==============================================================================

# Production Backend API Root (deployed on MilesWeb)
# In Vercel Project Settings -> Environment Variables, add VITE_API_BASE_URL:
# Example: https://api.hoposhop.in (or https://yourdomain.com/backend/public)
# In local development, leaving it blank or setting it to http://127.0.0.1:8000 connects to local PHP server.
VITE_API_BASE_URL=https://api.hoposhop.in

