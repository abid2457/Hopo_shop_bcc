# ==============================================================================
# HOPO SHOP ATELIER — MilesWeb Apache Production Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Pass Authorization Header to FastCGI/PHP-FPM (CRITICAL FOR MILESWEB)
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Allow direct access to existing files & directories (e.g. uploaded images)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route all other requests to Front Controller (index.php)
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Prevent directory indexing
Options -Indexes

# Block direct access to hidden files and sensitive extensions
<FilesMatch "^\.|\.(env|sql|log|ini|yml|yaml|md|git|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
