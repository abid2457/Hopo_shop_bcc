# ==============================================================================
# HOPO SHOP ATELIER — BACKEND CONFIGURATION
# Copy this file to .env and configure for your environment (Local or MilesWeb cPanel).
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
# Set to 'production' on MilesWeb. Set APP_DEBUG=false for live production.
APP_ENV=production
APP_DEBUG=false

# Backend public root URL (on MilesWeb: https://api.yourdomain.com or https://yourdomain.com/backend/public)
APP_URL=https://api.hoposhop.in

# Frontend URL for CORS authorization (Your Vercel deployment URL)
FRONTEND_URL=https://hopo-shop.vercel.app

# --- DATABASE CONFIGURATION (MILESWEB CPANEL / MYSQL 8.0+) ---
# Note for MilesWeb cPanel:
# 1. DB_HOST is usually 'localhost' or '127.0.0.1' on cPanel shared hosting.
# 2. Both DB_NAME and DB_USER in cPanel include your cPanel username prefix (e.g. hopo_shopdb).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_hoposhop
DB_USER=cpaneluser_dbuser
DB_PASSWORD=ChangeToYourSecureDatabasePassword2026!
DB_CHARSET=utf8mb4

# --- AUTHENTICATION & SECURITY ---
# Generate a cryptographically secure 64-character secret key for production JWT tokens:
JWT_SECRET=generate_a_random_64_character_hex_or_base64_secret_key_for_production
JWT_TTL=86400

# --- LUXURY E-COMMERCE BUSINESS RULES ---
GST_RATE=0.05
SHIPPING_FEE=149.00
FREE_SHIPPING_THRESHOLD=1999.00

# --- STORAGE & UPLOADS ---
# Path relative to backend root where admin image uploads are stored
UPLOAD_DIR=public/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,avif

